version=1.6.1
revision=1
build_style=gnu-configure
configure_args="--enable-custom-modes --enable-opus-custom-api"
short_desc="Totally open, royalty-free, highly versatile audio codec (debloated)"
maintainer="Orphaned <orphan@voidlinux.org>"
license="BSD-3-Clause"
homepage="https://www.opus-codec.org/"
distfiles="https://downloads.xiph.org/releases/opus/opus-${version}.tar.gz"
checksum=6ffcb593207be92584df15b32466ed64bbec99109f007c82205f0194572411a1

