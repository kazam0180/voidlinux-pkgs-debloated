# Template file for 'librsvg-mini'
pkgname=librsvg-mini
version=2.59.2
revision=1
build_style=meson
build_helper="rust"
configure_args="-Dpixbuf-loader=enabled -Dintrospection=disabled"
CFLAGS="${CFLAGS//-O2/-Os}"
hostmakedepends="cargo cargo-c pkg-config glib-devel gdk-pixbuf-devel python3-docutils"
makedepends="cairo-devel freetype-devel gdk-pixbuf-devel libcroco-devel
 libglib-devel libxml2-devel pango-devel libdav1d-devel rust-std"
short_desc="SVG library for GNOME - debloated, pixbuf-loader only"
maintainer="Orphaned <orphan@voidlinux.org>"
license="LGPL-2.1-or-later"
homepage="https://gitlab.gnome.org/GNOME/librsvg"
changelog="https://gitlab.gnome.org/GNOME/librsvg/-/raw/main/NEWS"
distfiles="${GNOME_SITE}/librsvg/${version%.*}/librsvg-${version}.tar.xz"
checksum=ecd293fb0cc338c170171bbc7bcfbea6725d041c95f31385dc935409933e4597
make_check=no

post_patch() {
	if [ "$CROSS_BUILD" ]; then
		vsed -i meson.build -e "s/not meson.is_cross_build() and //"
	fi
}

if [ "$CROSS_BUILD" ]; then
	XBPS_CROSS_RUSTFLAGS+=" -L${XBPS_BUILDDIR}/${pkgname}-${version}/build/rsvg"
	configure_args+=" -Dtriplet=${XBPS_CROSS_RUST_TARGET}"
fi
