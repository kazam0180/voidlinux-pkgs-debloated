# Template file for 'mesa-nano'
# Debloated variant of mesa, similar to mesa-mini but built with -Os for
# further size reduction (~30% smaller). Note: -Os can have performance
# and stability issues, so do not use for emulators or latency-sensitive apps.
pkgname=mesa-nano
version=26.1.8
revision=1
build_style=meson
configure_args="-Dglvnd=enabled -Dgbm=enabled -Degl=enabled -Dlibunwind=disabled
 -Dgles1=enabled -Dgles2=enabled -Dglx=dri
 -Dlmsensors=disabled -Dplatforms=x11,wayland
 -Dllvm=enabled -Db_lto=false -Dcpp_std=gnu++17
 -Dintel-rt=disabled -Dgallium-rusticl=false -Dvalgrind=disabled
 -Dvideo-codecs=all -Ddraw-use-llvm=false -Damd-use-llvm=false"
hostmakedepends="gettext flex pkg-config python3-Mako python3-yaml glslang wayland-protocols wayland-devel"
makedepends="elfutils-devel expat-devel libXdamage-devel
 libXxf86vm-devel libdrm-devel libffi-devel libva-devel libdisplay-info
 libxshmfence-devel ncurses-devel zlib-devel
 wayland-devel wayland-protocols libsensors-devel
 libXrandr-devel libglvnd-devel libzstd-devel libxml2-devel lua54-devel
 libarchive-devel libXext-devel libpng-devel"
depends="libglvnd"
short_desc="Open source implementation of OpenGL and Vulkan (debloated, -Os)"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT, LGPL-2.1-or-later"
homepage="https://www.mesa3d.org/"
changelog="https://docs.mesa3d.org/relnotes.html"
distfiles="https://mesa3d.org/archive/mesa-${version}.tar.xz"
checksum=b320f65874fd9653ac6c0bd1616605387344e1247411a50c797b5f3fb9dc0b55

