# Size-optimize with -Os (matching the Arch nano variant)
CFLAGS="${CFLAGS//-O2/-Os}"

build_options=""
build_options_default=""

# Same minimal driver set as mesa-mini
_gallium_drivers=" -Dgallium-drivers=softpipe"
_vulkan_drivers=" -Dvulkan-drivers="

case "$XBPS_TARGET_MACHINE" in
	i686*|x86_64*)
		_gallium_drivers+="zink,crocus,iris,r600,radeonsi,nouveau,svga,virgl"
		_vulkan_drivers+="intel,intel_hasvk,amd,nouveau,virtio"
		;;
	aarch64*)
		_gallium_drivers+="zink,asahi,freedreno,etnaviv,lima,panfrost,v3d,vc4,nouveau,svga,virgl,radeonsi"
		_vulkan_drivers+="broadcom,freedreno,panfrost,asahi,amd,nouveau,virtio"
		;;
	armv[67]*)
		_gallium_drivers+="zink,freedreno,etnaviv,lima,panfrost,v3d,vc4,nouveau,svga,virgl"
		_vulkan_drivers+="broadcom,freedreno,panfrost,virtio"
		;;
esac

configure_args+=" ${_vulkan_drivers} ${_gallium_drivers}"

replaces="libGL>=10_1<19.2.5_2 libEGL>=10_1<19.2.5_2 libGLES>=10_1<19.2.5_2"

post_install() {
	if [ -d docs ]; then
		vlicense docs/license.rst
	fi
}
